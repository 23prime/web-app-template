#!/usr/bin/env bash
#MISE description="Run a fuzz target for a bounded duration"
set -euo pipefail

if [ "$#" -ne 2 ]; then
  echo "Usage: mise run rs-fuzz -- <target> <seconds>" >&2
  exit 1
fi

target="$1"
seconds="$2"

case "${target}" in
  create_user_input | login_input) ;;
  *)
    echo "target must be create_user_input or login_input, got: ${target}" >&2
    exit 1
    ;;
esac

if ! [[ "${seconds}" =~ ^[1-9][0-9]*$ ]]; then
  echo "seconds must be a positive integer, got: ${seconds}" >&2
  exit 1
fi

rustup -q toolchain install nightly --profile minimal
cargo +nightly fuzz --help > /dev/null 2>&1 || cargo install cargo-fuzz --locked

cd app/use_case
cargo +nightly fuzz run "${target}" -- -max_total_time="${seconds}"
